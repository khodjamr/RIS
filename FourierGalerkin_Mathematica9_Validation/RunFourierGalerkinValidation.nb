Notebook[{

Cell[CellGroupData[{
Cell["Independent Fourier-Galerkin Validation", "Title"],

Cell["\<\
Mathematica 9 launcher for the frozen dual-mode conformal-metasurface \
configurations. This notebook loads a self-contained spectral package. It \
does not load or call DualModeRIS.m.\
\>", "Text"],

Cell[CellGroupData[{

Cell["1. Load the independent package", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"SetDirectory", "[", 
  RowBox[{"NotebookDirectory", "[", "]"}], "]"}]], "Input"],

Cell[BoxData["\<\"C:\\\\Users\\\\mrkho_000\\\\Desktop\\\\IEEE_TAP_DualMode_\
Metasurface\\\\FourierGalerkin_Mathematica9_Validation\"\>"], "Output",
 CellChangeTimes->{4.0017705087308817`*^9, 4.0017724564801855`*^9, 
  4.001777259466916*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{"Get", "[", "\"\<FourierGalerkinValidation.m\>\"", "]"}]], "Input"]
}, Open  ]],

Cell[CellGroupData[{

Cell["2. Run the mandatory checks", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fgSelfTestResult", "=", 
  RowBox[{"FGSelfTest", "[", "]"}]}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData["\<\"FGSelfTest: starting independent Fourier--Galerkin \
checks...\"\>"], "Print",
 CellChangeTimes->{4.0017705093245935`*^9, 4.001772457636362*^9, 
