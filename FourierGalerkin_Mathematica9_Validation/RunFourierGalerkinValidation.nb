Cell["\<\
The production study starts only if every self-test passes. The default \
retained half-orders are M = 64, 128, 192, and 256, corresponding to 129, \
257, 385, and 513 complex Fourier modes.\
\>", "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3. Run the independent validation", "Section"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"fgStudySummary", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", 
     RowBox[{"\"\<Passed\>\"", "/.", "fgSelfTestResult"}], "]"}], ",", 
    RowBox[{"FGRunValidation", "[", 
     RowBox[{"FGRunSelfTest", "->", "False"}], "]"}], ",", 
    RowBox[{
    "Print", "[", 
     "\"\<Production run cancelled because FGSelfTest did not pass.\>\"", 
     "]"}]}], "]"}]}]], "Input"],

