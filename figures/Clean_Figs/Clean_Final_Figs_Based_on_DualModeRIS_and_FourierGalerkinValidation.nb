  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{
     "polarCartesian", ",", "polarGridLines", ",", "polarGridLabels", ",", 
      "stepCoordinatesXY"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"polarCartesian", "[", "data_List", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "xy", "}"}], ",", 
       RowBox[{
        RowBox[{"xy", "=", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", 
               RowBox[{"Cos", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], " ", 
               RowBox[{"Sin", "[", 
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "}"}], "&"}], 
           ")"}], "/@", "data"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Append", "[", 
         RowBox[{"xy", ",", 
          RowBox[{"First", "[", "xy", "]"}]}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"polarGridLines", "[", 
      RowBox[{"maxRadius_", ",", "radialTicks_List"}], "]"}], ":=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.82", "]"}], ",", "Thin"}], "]"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Circle", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "0"}], "}"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "&"}], ")"}], "/@", 
        RowBox[{"Select", "[", 
         RowBox[{"radialTicks", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&"}]}], "]"}]}], 
       ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Line", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", "0"}], "}"}], ",", 
             RowBox[{"maxRadius", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Cos", "[", "#", "]"}], ",", 
                RowBox[{"Sin", "[", "#", "]"}]}], "}"}]}]}], "}"}], "]"}], 
          "&"}], ")"}], "/@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "7"}], "]"}], " ", 
          RowBox[{"Pi", "/", "4"}]}], ")"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"polarGridLabels", "[", 
      RowBox[{"maxRadius_", ",", "radialTicks_List"}], "]"}], ":=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Text", "[", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ",", "polarTickFont", ",", 
              RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}]}], "]"}], 
            ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "0"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1.15"}], ",", 
              RowBox[{"-", "1.15"}]}], "}"}]}], "]"}], "&"}], ")"}], "/@", 
        "radialTicks"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<0\[Degree]\>\"", ",", "polarAngleFont", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"1.1", " ", "maxRadius"}], ",", "0"}], "}"}]}], "]"}], 
         ",", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<90\[Degree]\>\"", ",", "polarAngleFont", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"1.1", " ", "maxRadius"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<180\[Degree]\>\"", ",", "polarAngleFont", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "1.1"}], " ", "maxRadius"}], ",", "0"}], "}"}]}], 
          "]"}], ",", 
         RowBox[{"Text", "[", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{"\"\<-90\[Degree]\>\"", ",", "polarAngleFont", ",", 
             RowBox[{"FontFamily", "\[Rule]", "\"\<Times\>\""}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"-", "1.1"}], " ", "maxRadius"}]}], "}"}]}], "]"}]}], 
        "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"stepCoordinatesXY", "[", 
      RowBox[{"x_List", ",", "y_List"}], "]"}], ":=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"x", "[", 
                RowBox[{"[", "k", "]"}], "]"}], ",", 
               RowBox[{"y", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"x", "[", 
                RowBox[{"[", 
                 RowBox[{"k", "+", "1"}], "]"}], "]"}], ",", 
               RowBox[{"y", "[", 
                RowBox[{"[", "k", "]"}], "]"}]}], "}"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", 
             RowBox[{
              RowBox[{"Length", "[", "x", "]"}], "-", "1"}]}], "}"}]}], "]"}],
          ",", "1"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Last", "[", "x", "]"}], ",", 
          RowBox[{"Last", "[", "y", "]"}]}], "}"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"**", "**", "**", "**", "**", "**", "**", "**", "Panel"}], " ", 
     "4", "a"}], "*****************)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"d4a", "=", 
     RowBox[{"readCSV", "[", 
      RowBox[{"mainDir", ",", "\"\<fig4a_telemetry_polar_pattern.csv\>\""}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"telemetryAngles", "=", 
     RowBox[{
      RowBox[{"d4a", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "1"}], "]"}], "]"}], " ", "Degree"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"telemetryDB", "=", 
     RowBox[{"d4a", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "3"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freeSpaceDB", "=", 
     RowBox[{"d4a", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "4"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radialMaximum", "=", "35."}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"radialMinimumDB", "=", 
     RowBox[{"-", "35."}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"telemetryPolarData", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"telemetryAngles", ",", 
        RowBox[{"radialMaximum", "+", 
