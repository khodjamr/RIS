          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"radialMinimumDB", ",", "#"}], "]"}], "&"}], "/@", 
           "telemetryDB"}], ")"}]}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"freeSpacePolarData", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"telemetryAngles", ",", 
        RowBox[{"radialMaximum", "+", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Max", "[", 
             RowBox[{"radialMinimumDB", ",", "#"}], "]"}], "&"}], "/@", 
           "freeSpaceDB"}], ")"}]}]}], "}"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p4a", "=", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"{", 
